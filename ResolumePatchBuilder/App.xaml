<Application x:Class="ResolumePatchBuilder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#121212" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F99B06" />
    <SolidColorBrush x:Key="LineBrush" Color="#343434" />
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="Background" Value="#252525" />
      <Setter Property="BorderBrush" Value="#555555" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="#A66500" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="Background" Value="#252525" />
      <Setter Property="BorderBrush" Value="#555555" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="Background" Value="#252525" />
      <Setter Property="Padding" Value="8,6" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#3A2A14" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#3A2A14" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="Margin" Value="0,4,10,4" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="Background" Value="#292929" />
      <Setter Property="BorderBrush" Value="#414141" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#1E1E1E" />
      <Setter Property="Foreground" Value="#A0A0A0" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="#1E1E1E" />
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="BorderBrush" Value="#2D2D2D" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#252525" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
